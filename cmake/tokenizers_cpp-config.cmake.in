@PACKAGE_INIT@

set_and_check(
  _tokenizers_cpp_public_header
  "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/tokenizers_cpp.h"
)
set_and_check(
  _tokenizers_c_public_header
  "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/tokenizers_c.h"
)
set_and_check(
  _tokenizers_cpp_rust_library
  "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@TOKENIZERS_RUST_LIB_NAME@"
)
set_and_check(
  _tokenizers_cpp_msgpack_targets
  "@PACKAGE_CMAKE_INSTALL_LIBDIR@/cmake/msgpack-cxx/msgpack-cxx-targets.cmake"
)
set_and_check(
  _tokenizers_cpp_targets
  "${CMAKE_CURRENT_LIST_DIR}/tokenizers_cpp-targets.cmake"
)

# msgpack is installed into the same prefix because tokenizers-cpp uses its
# interface target privately. Load that co-installed target without requiring
# downstream projects to add another package search path.
if(NOT TARGET msgpack-cxx)
  include("${_tokenizers_cpp_msgpack_targets}")
endif()

# Cargo produces a static archive outside CMake's native target model. Recreate
# its imported target before loading the exported C++ target that depends on it.
if(NOT TARGET tokenizers_cpp::tokenizers_c)
  add_library(tokenizers_cpp::tokenizers_c STATIC IMPORTED)
  set_target_properties(
    tokenizers_cpp::tokenizers_c
    PROPERTIES
      IMPORTED_LOCATION "${_tokenizers_cpp_rust_library}"
      INTERFACE_LINK_LIBRARIES "@TOKENIZERS_C_LINK_LIBS@"
  )
endif()

include("${_tokenizers_cpp_targets}")
check_required_components(tokenizers_cpp)

unset(_tokenizers_cpp_public_header)
unset(_tokenizers_c_public_header)
unset(_tokenizers_cpp_rust_library)
unset(_tokenizers_cpp_msgpack_targets)
unset(_tokenizers_cpp_targets)
